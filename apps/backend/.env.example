# Contoh env backend — aman dicommit. Copy ke .env lalu isi nilai asli.
ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWKS_URL=https://xxx.supabase.co/auth/v1/.well-known/jwks.json

JWT_SECRET=generate-dengan-secrets.token_urlsafe-48
JWT_REFRESH_SECRET=generate-dengan-secrets.token_urlsafe-48
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

KEK_SECRET=generate-dengan-secrets.token_hex-32

ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

SENTRY_DSN=
